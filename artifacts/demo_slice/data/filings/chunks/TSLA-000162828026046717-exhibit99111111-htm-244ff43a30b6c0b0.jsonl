{"accession_number": "0001628280-26-046717", "chunk_id": "TSLA-000162828026046717-exhibit99111111-htm-244ff43a30b6c0b0-chunk-0006-2ec51dc0acc31ea0c99df9c7", "chunk_text": "Investor Relations Contact: ir@tesla.com\n***\nOur net income and cash flow results will be announced along with the rest of our financial performance when we announce Q2 earnings. Tesla vehicle deliveries and storage deployments represent only two measures of the Company\u2019s financial performance and should not be relied on as an indicator of quarterly financial results, which depend on a variety of factors, including average selling price, cost of sales, foreign exchange movements and others as to be disclosed in the 10-Q for the quarter ended on June 30, 2026.", "cik": "0001318605", "document_id": "TSLA-000162828026046717-exhibit99111111-htm-244ff43a30b6c0b0", "document_role": "exhibit", "end_offset": 1997, "exhibit_type": "PRESS_RELEASE", "filed_at": "2026-07-02T13:01:26+00:00", "filing_date": "2026-07-02", "form_type": "EX-99", "item_number": "", "local_path": "C:\\Users\\aruba\\.buzz\\REPOS\\filings-market-intelligence\\data\\filings\\raw\\TSLA\\000162828026046717\\exhibit99111111.htm", "metadata": {"chunker_version": "sec_aware_v2", "content_hash": "202ebaa0a5c321246d3276b75ed9a446906c9a7ab4fbf974459a54735b220dc8", "description": "EX-99.1", "document_name": "exhibit99111111.htm", "item_number": "", "parser_version": "sec_text_v1", "report_date": "2026-07-02", "section_parser_version": "sec_sections_v3", "section_path": "Speaker: Investor Relations Contact", "speaker_name": "Investor Relations Contact", "speaker_role": ""}, "period_end": "2026-07-02", "section_path": "Speaker: Investor Relations Contact", "source_url": "https://www.sec.gov/Archives/edgar/data/1318605/000162828026046717/exhibit99111111.htm", "speaker_name": "Investor Relations Contact", "speaker_role": "", "start_offset": 1432, "ticker": "TSLA", "token_count": 90}
