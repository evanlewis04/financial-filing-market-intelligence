{"accession_number": "0001628280-26-022956", "chunk_id": "TSLA-000162828026022956-exhibit9911111-htm-5e7d2a8cefde5b78-chunk-0006-91e3be73f90e3b8751b3b0b2", "chunk_text": "Investor Relations Contact: ir@tesla.com\n***\nOur net income and cash flow results will be announced along with the rest of our financial performance when we announce Q1 earnings. Tesla vehicle deliveries and storage deployments represent only two measures of the Company\u2019s financial performance and should not be relied on as an indicator of quarterly financial results, which depend on a variety of factors, including average selling price, cost of sales, foreign exchange movements and others as to be disclosed in the 10-Q for the quarter ended on March 31, 2026.", "cik": "0001318605", "document_id": "TSLA-000162828026022956-exhibit9911111-htm-5e7d2a8cefde5b78", "document_role": "exhibit", "end_offset": 1996, "exhibit_type": "PRESS_RELEASE", "filed_at": "2026-04-02T13:07:13+00:00", "filing_date": "2026-04-02", "form_type": "EX-99", "item_number": "", "local_path": "C:\\Users\\aruba\\.buzz\\REPOS\\filings-market-intelligence\\data\\filings\\raw\\TSLA\\000162828026022956\\exhibit9911111.htm", "metadata": {"chunker_version": "sec_aware_v2", "content_hash": "b4f238b7884082e385afe15cb6f80614a31f670585f95fc410c583016cf8f474", "description": "EX-99.1", "document_name": "exhibit9911111.htm", "item_number": "", "parser_version": "sec_text_v1", "report_date": "2026-04-02", "section_parser_version": "sec_sections_v3", "section_path": "Speaker: Investor Relations Contact", "speaker_name": "Investor Relations Contact", "speaker_role": ""}, "period_end": "2026-04-02", "section_path": "Speaker: Investor Relations Contact", "source_url": "https://www.sec.gov/Archives/edgar/data/1318605/000162828026022956/exhibit9911111.htm", "speaker_name": "Investor Relations Contact", "speaker_role": "", "start_offset": 1430, "ticker": "TSLA", "token_count": 90}
